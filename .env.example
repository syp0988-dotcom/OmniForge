DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.2
MAX_TOKENS=1000
LOG_LEVEL=INFO
APP_NAME=OmniForge
DEBUG=false

# -- Embedding (DashScope / OpenAI-compatible) --
# text-embedding-v3 is 1024-d; text-embedding-v2 is 1536-d. The system
# auto-detects the dimension at runtime, so either works.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_CACHE_ENABLED=true
# Optional custom cache path; defaults to <project>/data/embedding_cache.db
EMBEDDING_CACHE_PATH=

# -- Knowledge search --
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SCORE=0.10

# -- Request & upload limits --
MAX_REQUEST_SECONDS=300
MAX_UPLOAD_BYTES=52428800
MAX_ZIP_ENTRIES=200
MAX_ZIP_UNCOMPRESSED_BYTES=524288000

# -- Knowledge reranking (optional; "llm" enables LLM reranking) --
KNOWLEDGE_RERANKER=none
KNOWLEDGE_RERANK_CANDIDATES=10
KNOWLEDGE_RERANK_TOP_K=3

# -- Deployment security --
# Set AUTH_TOKEN to require "Authorization: Bearer <token>" on all endpoints
# except /health. Leave empty for local-only use.
AUTH_TOKEN=
# Comma-separated allowed CORS origins, e.g. https://app.example.com
CORS_ORIGINS=

# -- Search configuration --
# Tavily (recommended, free tier at https://app.tavily.com)
TAVILY_API_KEY=
# Composio (optional, 500+ app integrations)
COMPOSIO_API_KEY=

# HTTP proxy for search providers (needed in China for DuckDuckGo/Tavily)
# Format: http://host:port  or  socks5://host:port
HTTP_PROXY=
HTTPS_PROXY=
