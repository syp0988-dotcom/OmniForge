DEEPSEEK_API_KEY=your-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-v4-flash
TEMPERATURE=0.2
MAX_TOKENS=1000
LOG_LEVEL=INFO
# Log rotation: files rotate at the given cadence, keeping N backups.
LOG_ROTATION_WHEN=midnight
LOG_ROTATION_BACKUP_COUNT=14
APP_NAME=OmniForge
DEBUG=false

# Runtime environment: development (default) or production.
# In production (or with ENFORCE_REQUIRED_ENV=true) startup fails fast when
# required API keys are missing instead of silently degrading.
APP_ENV=development
ENFORCE_REQUIRED_ENV=false

# -- Embedding (DashScope / OpenAI-compatible) --
# REQUIRED for: knowledge-base vector retrieval (RAG), embedding-based
# intent fast path, embedding cache.  When missing, the system degrades to
# lexical-only retrieval and LLM intent analysis (slower, but functional).
# text-embedding-v3 is 1024-d; text-embedding-v2 is 1536-d. The system
# auto-detects the dimension at runtime, so either works.
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL_NAME=text-embedding-v3
EMBEDDING_CACHE_ENABLED=true
# Optional custom cache path; defaults to <project>/data/embedding_cache.db
EMBEDDING_CACHE_PATH=

# -- Intent analysis --
INTENT_CONFIDENCE_RATIO=1.5
INTENT_MIN_SCORE_FLOOR=0.20
# Default knowledge source for question intents: general | hybrid | local
INTENT_QUESTION_SOURCE=hybrid

# -- Per-node LLM token budgets (override global MAX_TOKENS) --
PLANNER_MAX_TOKENS=4000
CODEGEN_MAX_TOKENS=8000
# Optional: use a stronger model for project code generation.
# Leave empty to use the global MODEL_NAME. Example: deepseek-v4-pro
CODEGEN_MODEL=
ANSWER_MAX_TOKENS=2000
GOAL_ANALYZER_MAX_TOKENS=600

# -- Tool-call repair (one LLM pass to fix failed tool arguments) --
TOOL_CALL_REPAIR_ENABLED=true

# -- Knowledge search --
KNOWLEDGE_TOP_K=5
KNOWLEDGE_MIN_SCORE=0.10

# -- Vector index (Qdrant) --
# Leave QDRANT_URL empty to use the local on-disk index (data/qdrant),
# which is persisted via the Docker/K8s data volume. Set a URL to use a
# remote/cloud Qdrant server.
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=knowledge_chunks

# -- Request & upload limits --
MAX_REQUEST_SECONDS=300
MAX_UPLOAD_BYTES=52428800
MAX_ZIP_ENTRIES=200
MAX_ZIP_UNCOMPRESSED_BYTES=524288000

# -- Workflow termination policy --
# Loop guards that stop infinite planner/reflector cycles. Tune per workload:
# larger values allow longer agent runs at the cost of worse worst-case latency.
MAX_PLANNER_CYCLES=5
MAX_REPLAN_COUNT=3
MAX_STUCK_ROUNDS=3
REFLECTOR_PLANNER_CYCLE_CAP=4

# -- Layered memory (history compression) --
# Older turns are compressed into a rolling summary once raw history exceeds
# the token budget; the most recent turns are always kept verbatim.
ENABLE_HISTORY_COMPRESSION=true
HISTORY_TOKEN_BUDGET=8000
HISTORY_MIN_KEEP_MESSAGES=6

# -- Knowledge reranking (optional; "llm" enables LLM reranking) --
KNOWLEDGE_RERANKER=none
KNOWLEDGE_RERANK_CANDIDATES=10
KNOWLEDGE_RERANK_TOP_K=3

# -- Deployment security --
# Set AUTH_TOKEN to require "Authorization: Bearer <token>" on all endpoints
# except /health. Leave empty for local-only use.
AUTH_TOKEN=
# Comma-separated allowed CORS origins, e.g. https://app.example.com
CORS_ORIGINS=

# -- Search configuration --
# REQUIRED for: high-quality web search.  When missing, search falls back to
# DuckDuckGo (works but rate-limited / less structured results).
# Tavily (recommended, free tier at https://app.tavily.com)
TAVILY_API_KEY=
# Composio (optional, 500+ app integrations). When missing, the composio
# tool reports "not configured" instead of crashing.
COMPOSIO_API_KEY=

# HTTP proxy for search providers (needed in China for DuckDuckGo/Tavily)
# Format: http://host:port  or  socks5://host:port
HTTP_PROXY=
HTTPS_PROXY=
